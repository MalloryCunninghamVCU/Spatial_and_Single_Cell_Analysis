obj$subclass <- unname(cluster_subclass_map[as.character(obj$seurat_clusters)])

# ----------------------------
# 2) UPDATED immune sets (strict)
#    Require pan-immune + lineage support
# ----------------------------
gene_sets2 <- list(
  PanImmune = c("GRCh38-PTPRC"),
  T_NK      = c("GRCh38-CD3D","GRCh38-CD3E","GRCh38-CD8A","GRCh38-CD4","GRCh38-GZMA"),
  Myeloid   = c("GRCh38-LYZ","GRCh38-FCGR3A","GRCh38-CD68","GRCh38-ITGAM","GRCh38-NCF1"),
  Bcell     = c("GRCh38-MS4A1","GRCh38-CD79A")
)
gene_sets2 <- lapply(gene_sets2, function(x) intersect(x, rownames(obj)))
gene_sets2 <- gene_sets2[sapply(gene_sets2, length) >= 1]

obj <- AddModuleScore(
  obj,
  features = gene_sets2,
  assay = "Spatial.008um",
  name = c("PanImmune_Score","T_NK_Score","Myeloid_Score","Bcell_Score")
)

pan_col <- grep("^PanImmune_Score", colnames(obj@meta.data), value = TRUE)[1]
tnk_col <- grep("^T_NK_Score",      colnames(obj@meta.data), value = TRUE)[1]
my_col  <- grep("^Myeloid_Score",   colnames(obj@meta.data), value = TRUE)[1]
b_col   <- grep("^Bcell_Score",     colnames(obj@meta.data), value = TRUE)[1]

# stringent thresholds
thr_pan <- quantile(obj[[pan_col]][,1], 0.99,  na.rm = TRUE)
thr_t   <- quantile(obj[[tnk_col]][,1], 0.995, na.rm = TRUE)
thr_m   <- quantile(obj[[my_col]][,1],  0.995, na.rm = TRUE)
thr_b   <- quantile(obj[[b_col]][,1],   0.995, na.rm = TRUE)

pan_pos <- obj[[pan_col]][,1] >= thr_pan
t_pos   <- obj[[tnk_col]][,1] >= thr_t
m_pos   <- obj[[my_col]][,1]  >= thr_m
b_pos   <- obj[[b_col]][,1]   >= thr_b

obj$immune_subtype <- NA_character_
obj$immune_subtype[pan_pos & t_pos] <- "Immune_T/NK-like"
obj$immune_subtype[pan_pos & m_pos] <- "Immune_Myeloid-like"
obj$immune_subtype[pan_pos & b_pos] <- "Immune_B-like"

# resolve multi-hits by strongest lineage score
multi <- pan_pos & (t_pos + m_pos + b_pos > 1)
if (any(multi)) {
  score_mat <- cbind(
    T_NK = obj[[tnk_col]][,1],
    Myeloid = obj[[my_col]][,1],
    Bcell = obj[[b_col]][,1]
  )
  best <- apply(score_mat[multi, , drop = FALSE], 1, function(z) names(which.max(z)))
  obj$immune_subtype[multi] <- paste0("Immune_", best, "-like")
}

