# Name each dataset based on directory path 
dir_to_name <- function(d) {
  bn <- basename(d)
  if (bn %in% c("filtered_feature_bc_matrix", "raw_feature_bc_matrix")) {
    basename(dirname(d))  # name by parent folder
  } else {
    bn                  
  }
}



