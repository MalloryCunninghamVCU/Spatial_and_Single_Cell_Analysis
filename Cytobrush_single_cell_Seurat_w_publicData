markers <- FindAllMarkers(
  immune.combined.sct,
  assay = "SCT",
  only.pos = TRUE,
  logfc.threshold = 0.25,
  min.pct = 0.1
)


top10 <- markers %>%
  group_by(cluster) %>%
  slice_max(order_by = avg_log2FC, n = 2) %>%
  pull(gene) %>%
  unique()



topN_by_fc <- markers %>%
  group_by(cluster) %>%
  slice_max(order_by = avg_log2FC, n = 2, with_ties = FALSE) %>%
  ungroup()

topN_by_fc



# DoHeatmap needs scaled data for the plotted features
immune.combined.sct <- ScaleData(
  immune.combined.sct,
  assay = "SCT",
  features = top10,
  verbose = FALSE
)

p_heat <- DoHeatmap(
  immune.combined.sct,
  assay = "SCT",
  features = top10,
  group.by = "seurat_clusters",
  size = 3
) 




